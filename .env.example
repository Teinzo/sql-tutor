# Kopirajte ovu datoteku u .env i popunite vrijednosti.
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# .env je u .gitignore i ne smije zavrsiti u repozitoriju.

# --- Jezicni model (obavezno) -----------------------------------------------
# Kljuc se dobiva na https://platform.openai.com/api-keys
# Racun mora imati uplacene kredite, inace API vraca gresku o kvoti.
OPENAI_API_KEY=sk-...

# Glavni model. gpt-5.6-luna je najjeftiniji i dovoljan za sve funkcionalnosti.
OPENAI_MODEL=gpt-5.6-luna

# Pricuvni model na koji se prelazi ako glavni nije dostupan.
# Ostavite prazno da se pricuva iskljuci.
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# --- Aplikacija -------------------------------------------------------------
APP_NAME=SQL Tutor
APP_URL=http://localhost:8000

# --- Ponasanje kod poziva modela --------------------------------------------
# Vremensko ogranicenje jednog poziva u sekundama.
LLM_TIMEOUT=60
# Broj ponovnih pokusaja kod privremenih gresaka.
LLM_MAX_RETRIES=3
# Osnovno cekanje izmedu pokusaja u sekundama.
LLM_RETRY_BACKOFF=1.5

# --- Sigurnost --------------------------------------------------------------
# Trajanje prijave u satima.
SESSION_HOURS=12

# Lozinke demo racuna koji se kreiraju pri prvom pokretanju prazne baze.
# Zadane vrijednosti navedene su u README-u, pa ih obavezno promijenite
# ako aplikacija nece raditi samo lokalno.
DEMO_LOZINKA_NASTAVNIK=nastavnik123
DEMO_LOZINKA_STUDENT=student123
